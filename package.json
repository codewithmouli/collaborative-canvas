{
  "name": "collaborative-canvas",
  "version": "1.0.0",
  "description": "Real-time collaborative drawing canvas",
  "type": "commonjs",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "server": "ts-node --project tsconfig.server.json server/server.ts",
    "build": "vite build --config vite.config.ts && tsc --project tsconfig.server.json",
    "start": "node dist/server/server/server.js"
  },
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
